<?xml version="1.0" ?>
<robot name="home_botv2" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<material name="silver">
  <color rgba="0.700 0.700 0.700 1.000"/>
</material>
<material name="black">
  <color rgba="0.1 0.1 0.1 1"/>
</material>

<material name="blue">
  <color rgba="0.2 0.4 1.0 1"/>
</material>

<material name="red">
  <color rgba="1 0.2 0.2 1"/>
</material>

</robot>
