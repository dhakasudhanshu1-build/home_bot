<link name="lidar_link_1">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.1109767604880594"/>
    <inertia ixx="1e-05" iyy="1e-05" izz="1.2e-05" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://home_botv2_description/meshes/lidar_link.stl" scale="1 1 1"/>
    </geometry>
    <material name="red"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://home_botv2_description/meshes/lidar_link.stl" scale="1 1 1"/>
    </geometry>
  </collision>
</link>

<joint name="Revolute_1" type="continuous">
  <origin xyz="-0.144945 0.170055 0.02" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="left_wheel_link_1"/>
  <axis xyz="0 1 0"/>
</joint>

<joint name="Revolute_2" type="continuous">
  <origin xyz="-0.144945 -0.169945 0.02" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="right_wheel_link_1"/>
  <axis xyz="0 1 0"/>
</joint>

<joint name="Rigid_3" type="fixed">
  <origin xyz="0.175055 0.100055 -0.005" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="caster_left_link_1"/>
</joint>

<joint name="Rigid_4" type="fixed">
  <origin xyz="0.175055 -0.099945 -0.005" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="caster_right_link_1"/>
</joint>

<joint name="Rigid_5" type="fixed">
  <origin xyz="-0.1 0 0.22" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="back_box_link_1"/>
</joint>

<joint name="Rigid_6" type="fixed">
  <origin xyz="0 0 0.22" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="tower_link_1"/>
</joint>

<joint name="Rigid_7" type="fixed">
  <origin xyz="0 -0.02 0.29" rpy="0 0 0"/>
  <parent link="tower_link_1"/>
  <child link="camera_link_1"/>
</joint>

<joint name="Rigid_8" type="fixed">
  <origin xyz="0.0 0.015 0.3" rpy="0 0 0"/>
  <parent link="tower_link_1"/>
  <child link="lidar_link_1"/>
</joint>


<gazebo reference="lidar_link_1">
  <sensor name="gpu_lidar" type="gpu_lidar">
    <update_rate>10</update_rate>
    <always_on>true</always_on>
    <visualize>true</visualize>
    <lidar>
      <scan>
        <horizontal>
          <samples>640</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.08</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
    </lidar>
    <always_on>1</always_on>
    <visualize>true</visualize>
    <topic>scan</topic>
    <gz_frame_id>lidar_link_1</gz_frame_id>
  </sensor>

</gazebo>



</robot>
