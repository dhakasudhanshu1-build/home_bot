<?xml version="1.0" ?>
<robot name="home_botv2" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find home_botv2_description)/urdf/materials.xacro" />
<xacro:include filename="$(find home_botv2_description)/urdf/home_botv2.ros2control" />
<xacro:include filename="$(find home_botv2_description)/urdf/home_botv2.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="5.0"/>
    <inertia ixx="0.040" iyy="0.040" izz="0.072" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 1.5708"/>
    <geometry>
      <mesh filename="package://home_botv2_description/meshes/base_link.stl" scale="1 1 1"/>
    </geometry>
    <material name="blue"/>
  </visual>
  <collision>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <geometry>
      <!-- <mesh filename="package://home_botv2_description/meshes/base_link.stl" scale="1 1 1"/> -->
      <box size="0.45 0.35 0.12"/>
    </geometry>
  </collision>
</link>

<link name="left_wheel_link_1">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.5"/>
    <inertia ixx="0.000516" iyy="0.0009" izz="0.000516" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 1.570"/>
    <geometry>
      <mesh filename="package://home_botv2_description/meshes/left_wheel_link.stl" scale="1 1 1"/>
    </geometry>
    <material name="black"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="1.5708 0 0"/>
    <geometry>
      <!-- <mesh filename="package://home_botv2_description/meshes/left_wheel_link.stl" scale="1 1 1"/> -->
      <cylinder radius="0.06" length="0.04"/>
    </geometry>
  </collision>
</link>

<link name="right_wheel_link_1">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.5"/>
    <inertia ixx="0.000516" iyy="0.0009" izz="0.000516" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 -1.570"/>
    <geometry>
      <mesh filename="package://home_botv2_description/meshes/right_wheel_link.stl" scale="1 1 1"/>
    </geometry>
    <material name="black"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="-1.5708 0 0"/>
    <geometry>
      <!-- <mesh filename="package://home_botv2_description/meshes/right_wheel_link.stl" scale="1 1 1"/> -->
      <cylinder radius="0.06" length="0.04"/>
    </geometry>
  </collision>
</link>
<link name="caster_left_link_1">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.1"/>
    <inertia ixx="0.000016" iyy="0.000016" izz="0.000016" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://home_botv2_description/meshes/caster_left_link.stl" scale="1 1 1"/>
    </geometry>
    <material name="black"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <!-- <mesh filename="package://home_botv2_description/meshes/caster_left_link.stl" scale="1 1 1"/> -->
      <sphere radius="0.02"/> 
    </geometry>
  </collision>
</link>

<link name="caster_right_link_1">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.1"/>
    <inertia ixx="0.000016" iyy="0.000016" izz="0.000016" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://home_botv2_description/meshes/caster_right_link.stl" scale="1 1 1"/>
    </geometry>
    <material name="black"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <!-- <mesh filename="package://home_botv2_description/meshes/caster_right_link.stl" scale="1 1 1"/> -->
      <sphere radius="0.02"/>
    </geometry>
  </collision>
</link>

<link name="back_box_link_1">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="1.0"/>
    <inertia ixx="0.0066" iyy="0.0066" izz="0.0066" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://home_botv2_description/meshes/back_box_link.stl" scale="1 1 1"/>
    </geometry>
    <material name="silver"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://home_botv2_description/meshes/back_box_link.stl" scale="1 1 1"/>
    </geometry>
  </collision>
</link>

<link name="tower_link_1">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="2.0"/>
    <inertia ixx="0.0079" iyy="0.0079" izz="0.0025" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 1.57"/>
    <geometry>
      <mesh filename="package://home_botv2_description/meshes/tower_link.stl" scale="1 1 1"/>
    </geometry>
    <material name="blue"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 1.57"/>
    <geometry>
      <mesh filename="package://home_botv2_description/meshes/tower_link.stl" scale="1 1 1"/>
    </geometry>
  </collision>
</link>

<link name="camera_link_1">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.246"/>
    <inertia ixx="0.0001" iyy="0.0001" izz="0.0001" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 1.57"/>
    <geometry>
      <mesh filename="package://home_botv2_description/meshes/camera_link.stl" scale="1 1 1"/>
    </geometry>
    <material name="black"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 1.57"/>
    <geometry>
      <mesh filename="package://home_botv2_description/meshes/camera_link.stl" scale="1 1 1"/>
    </geometry>
  </collision>
</link>

<link name="lidar_link_1">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="0.11"/>
    <inertia ixx="0.000066" iyy="0.000066" izz="0.000088" ixy="0.0" iyz="0.0" ixz="0.0"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://home_botv2_description/meshes/lidar_link.stl" scale="1 1 1"/>
    </geometry>
    <material name="red"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <geometry>
      <mesh filename="package://home_botv2_description/meshes/lidar_link.stl" scale="1 1 1"/>
    </geometry>
  </collision>
</link>

<joint name="Revolute_1" type="continuous">
  <origin xyz="-0.144945 0.170055 0.02" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="left_wheel_link_1"/>
  <axis xyz="0 1 0"/>
</joint>

<joint name="Revolute_2" type="continuous">
  <origin xyz="-0.144945 -0.169945 0.02" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="right_wheel_link_1"/>
  <axis xyz="0 1 0"/>
</joint>

<joint name="Rigid_3" type="fixed">
  <origin xyz="0.175055 0.100055 -0.02" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="caster_left_link_1"/>
</joint>

<joint name="Rigid_4" type="fixed">
  <origin xyz="0.175055 -0.099945 -0.02" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="caster_right_link_1"/>
</joint>

<joint name="Rigid_5" type="fixed">
  <origin xyz="-0.1 0 0.22" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="back_box_link_1"/>
</joint>

<joint name="Rigid_6" type="fixed">
  <origin xyz="0 0 0.22" rpy="0 0 0"/>
  <parent link="base_link"/>
  <child link="tower_link_1"/>
</joint>

<joint name="Rigid_7" type="fixed">
  <origin xyz="0 -0.02 0.29" rpy="0 0 0"/>
  <parent link="tower_link_1"/>
  <child link="camera_link_1"/>
</joint>

<joint name="Rigid_8" type="fixed">
  <origin xyz="0.0 0.015 0.3" rpy="0 0 0"/>
  <parent link="tower_link_1"/>
  <child link="lidar_link_1"/>
</joint>








<gazebo reference="lidar_link_1">
  <sensor name="gpu_lidar" type="gpu_lidar">
    <update_rate>20</update_rate>
    <always_on>true</always_on>
    <visualize>true</visualize>
    <lidar>
      <scan>
        <horizontal>
          <samples>320</samples>
          <resolution>1</resolution>
          <min_angle>-3.14159</min_angle>
          <max_angle>3.14159</max_angle>
        </horizontal>
      </scan>
      <range>
        <min>0.30</min>
        <max>12.0</max>
        <resolution>0.01</resolution>
      </range>
    </lidar>
    <always_on>1</always_on>
    <visualize>true</visualize>
    <topic>scan</topic>
    <ignition_frame_id>lidar_link_1</ignition_frame_id>
    <gz_frame_id>lidar_link_1</gz_frame_id>
  </sensor>

</gazebo>

<!-- Camera Sensor (Ignition Gazebo Fortress) -->
<gazebo reference="camera_link_1">
  <sensor name="rgb_camera" type="camera">
    <update_rate>20</update_rate>
    <always_on>true</always_on>
    <visualize>true</visualize>
    <camera>
      <horizontal_fov>1.3962634</horizontal_fov>
      <image>
        <width>640</width>
        <height>480</height>
        <format>R8G8B8</format>
      </image>
      <clip>
        <near>0.1</near>
        <far>100</far>
      </clip>
    </camera>
    <topic>camera/image_raw</topic>
    <gz_frame_id>camera_link_1</gz_frame_id>
  </sensor>
</gazebo>


</robot>
