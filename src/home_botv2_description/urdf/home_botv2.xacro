<?xml version="1.0" ?>
<robot name="home_botv2" xmlns:xacro="http://www.ros.org/wiki/xacro">

<xacro:include filename="$(find home_botv2_description)/urdf/materials.xacro" />
<xacro:include filename="$(find home_botv2_description)/urdf/home_botv2.ros2control" />
<xacro:include filename="$(find home_botv2_description)/urdf/home_botv2.gazebo" />
<link name="base_link">
  <inertial>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <mass value="24.10724553962157"/>
    <inertia ixx="3.137242" iyy="5.215086" izz="6.337405" ixy="-0.0" iyz="0.0" ixz="0.001793"/>
  </inertial>
  <visual>
    <origin xyz="0 0 0" rpy="0 0 1.5708"/>
    <geometry>
      <mesh filename="package://home_botv2_description/meshes/base_link.stl" scale="1 1 1"/>
    </geometry>
    <material name="blue"/>
  </visual>
  <collision>
    <origin xyz="0 0 0" rpy="0 0 1.5708"/>
    <geometry>
      <mesh filename="package://home_botv2_description/meshes/base_link.stl" scale="1 1 1"/>
    </geometry>
  </collision>
</link>

